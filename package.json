{
  "name": "baguetton-landing",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/gen-schema.mjs && node scripts/gen-paginas.mjs && node scripts/gen-feeds.mjs && node scripts/gen-sitemap.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "schema": "node scripts/gen-schema.mjs",
